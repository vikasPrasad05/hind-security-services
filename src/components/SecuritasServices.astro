---
import { navigation } from '../data/siteData';

const mainServices = [
  {
    title: 'Licensed Static Guards',
    category: 'PERSONNEL SECURITY',
    desc: 'Uniformed, trained static guards providing access control, visitor logging, asset protection, and emergency management.',
    image: '/images/indian_security_guards.png',
    link: '/services/static-guards'
  },
  {
    title: 'Mobile Security Patrols',
    category: 'RAPID RESPONSE',
    desc: '24/7 GPS-tracked mobile patrol units performing random lockups, alarm responses, and welfare checks.',
    image: '/images/slider_team.jpg',
    link: '/services/mobile-patrols'
  },
  {
    title: 'Autonomous Solar CCTV Trailers',
    category: 'SMART SURVEILLANCE',
    desc: 'Off-grid, AI-powered mobile surveillance trailers equipped with thermal PTZ cameras and live audio deterrence.',
    image: '/images/slider_3.png',
    link: '/services/solar-cctv-trailer'
  },
  {
    title: 'Grade A1 Control Room Monitoring',
    category: '24/7 OPERATIONS',
    desc: 'Continuous real-time video monitoring, back-to-base alarm verification, and immediate incident dispatch.',
    image: '/images/slider_3.png',
    link: '/services/control-room-monitoring'
  },
  {
    title: 'Concierge & Corporate Security',
    category: 'CUSTOMER EXCELLENCE',
    desc: 'Professional front-desk security officers blending customer service warmth with vigilant security oversight.',
    image: '/images/slider_2.png',
    link: '/services/concierge-security'
  },
  {
    title: 'Event & Crowd Management',
    category: 'PUBLIC SAFETY',
    desc: 'Comprehensive crowd control, entry screening, VIP protection, and emergency evacuation management.',
    image: '/images/indian_security_guards.png',
    link: '/services/event-security'
  }
];
---

<section class="sec-section sec-services-section" id="services">
  <div class="container">
    
    <!-- Section Header -->
    <div class="sec-services-header">
      <div class="sec-label">
        <span class="sec-purple-line"></span>
        CORE CAPABILITIES & SOLUTIONS
      </div>
      <h2 class="sec-heading">Comprehensive Security Services for Every Need</h2>
      <p class="sec-preamble">
        From frontline security personnel to autonomous AI surveillance towers, we deliver customized protection solutions tailored to your operational requirements.
      </p>
    </div>

    <!-- Securitas Service Cards Grid -->
    <div class="sec-services-grid">
      {mainServices.map((service) => (
        <a href={service.link} class="sec-card">
          <div class="sec-card-image-box">
            <img src={service.image} alt={service.title} loading="lazy" />
            <div class="sec-card-overlay"></div>
            <span class="sec-card-badge">{service.category}</span>
          </div>
          <div class="sec-card-body">
            <h3 class="sec-card-title">{service.title}</h3>
            <p class="sec-card-desc">{service.desc}</p>
            <div class="sec-card-action">
              <span class="sec-card-link">Discover service</span>
              <span class="sec-arrow-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Section Footer Link -->
    <div class="sec-services-bottom">
      <a href="/services" class="btn btn-dark">
        View All Security & Facility Services
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .sec-services-section {
    background-color: #ffffff;
    border-bottom: 1px solid var(--sec-grey-border);
  }

  .sec-services-header {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .sec-purple-line {
    display: inline-block;
    width: 24px;
    height: 3px;
    background-color: var(--sec-purple);
    border-radius: 2px;
  }

  .sec-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .sec-card {
    background: #ffffff;
    border: 1px solid var(--sec-grey-border);
    border-radius: 0;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .sec-card:hover {
    border-color: var(--sec-purple);
    box-shadow: 0 16px 36px rgba(3, 31, 48, 0.12);
  }

  .sec-card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
    background-color: var(--sec-navy);
  }

  .sec-card-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sec-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(3, 31, 48, 0.1) 0%, rgba(3, 31, 48, 0.4) 100%);
  }

  .sec-card-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #ffffff;
    background: #000000;
    padding: 0.35rem 0.75rem;
    border-radius: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .sec-card-body {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .sec-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--sec-navy);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .sec-card-desc {
    font-size: 0.925rem;
    color: var(--sec-text-muted);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .sec-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--sec-grey-border);
  }

  .sec-card-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--sec-navy);
    transition: color 0.3s ease;
  }

  .sec-card:hover .sec-card-link {
    color: var(--sec-purple);
  }

  .sec-card-action .sec-arrow-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--sec-navy);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .sec-card:hover .sec-arrow-circle {
    background-color: var(--sec-purple);
    transform: translateX(4px);
  }

  .sec-services-bottom {
    margin-top: 3.5rem;
    text-align: center;
  }

  .sec-services-bottom .btn {
    padding: 1rem 2rem;
    font-size: 1rem;
    background-color: var(--sec-navy);
  }

  .sec-services-bottom .btn:hover {
    background-color: var(--sec-purple);
  }

  @media (max-width: 1024px) {
    .sec-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .sec-services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
