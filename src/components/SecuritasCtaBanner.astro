---
import QuoteModal from './QuoteModal.astro';
---

<section class="sec-section sec-cta-banner-section">
  <div class="container">
    <div class="sec-cta-box">
      <div class="sec-cta-content">
        <h2 class="sec-cta-heading">Ready to Elevate Your Security Protection?</h2>
        <p class="sec-cta-desc">
          Get a transparent, customized security quote tailored specifically for your site, assets, and operational needs in minutes.
        </p>
      </div>

      <div class="sec-cta-actions">
        <button class="btn btn-primary btn-cta-quote" id="sec-open-quote-modal-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <line x1="6" y1="8" x2="6.01" y2="8"></line>
            <line x1="10" y1="8" x2="18" y2="8"></line>
            <line x1="6" y1="12" x2="6.01" y2="12"></line>
            <line x1="10" y1="12" x2="18" y2="12"></line>
            <line x1="6" y1="16" x2="6.01" y2="16"></line>
            <line x1="10" y1="16" x2="14" y2="16"></line>
          </svg>
          Calculate Security Quote
        </button>
        <a href="/contact" class="btn btn-outline">
          Speak With a Specialist
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <QuoteModal />
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('sec-open-quote-modal-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const modal = document.getElementById('quote-modal');
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      });
    }
  });
</script>

<style>
  .sec-cta-banner-section {
    background-color: #ffffff;
    padding: 5.5rem 0;
    color: var(--navy-dark);
    border-top: 1px solid var(--gray-200);
    position: relative;
  }

  .sec-cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .sec-cta-content {
    max-width: 650px;
  }

  .sec-cta-heading {
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 800;
    color: var(--navy-dark);
    margin-bottom: 1rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .sec-cta-desc {
    font-size: 1.1rem;
    color: var(--gray-600);
    line-height: 1.6;
    margin: 0;
  }

  .sec-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 260px;
  }

  .sec-cta-actions .btn {
    padding: 1.1rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 8px;
    width: 100%;
    justify-content: center;
    white-space: nowrap !important;
    transition: none !important;
    transform: none !important;
  }

  .sec-cta-actions .btn:hover {
    transform: none !important;
  }

  .sec-cta-actions .btn svg {
    transition: none !important;
    transform: none !important;
    flex-shrink: 0;
  }

  .sec-cta-actions .btn:hover svg {
    transform: none !important;
  }

  .btn-cta-quote {
    background-color: var(--primary-red);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(197, 118, 42, 0.25);
    border: none;
    transition: none !important;
    transform: none !important;
  }

  .btn-cta-quote:hover {
    background-color: var(--primary-red-hover);
    color: #ffffff;
    transform: none !important;
    box-shadow: 0 4px 14px rgba(197, 118, 42, 0.25) !important;
  }

  @media (max-width: 992px) {
    .sec-cta-box {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    .sec-cta-actions {
      width: 100%;
      flex-direction: column;
      gap: 0.75rem;
    }
    .sec-cta-actions .btn {
      padding: 0.9rem 1.5rem;
      font-size: 0.92rem;
    }
  }

  @media (max-width: 640px) {
    .sec-cta-banner-section {
      padding: 3rem 0;
    }
    .sec-cta-actions {
      flex-direction: column;
      width: 100%;
      gap: 0.65rem;
    }
    .sec-cta-actions .btn {
      padding: 0.75rem 1.15rem;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 420px) {
    .sec-cta-actions .btn {
      padding: 0.65rem 0.85rem;
      font-size: 0.8rem;
      gap: 0.35rem;
    }
    .sec-cta-actions .btn svg {
      width: 16px;
      height: 16px;
    }
  }
</style>
