---
import QuoteModal from './QuoteModal.astro';
---

<section class="sec-section sec-cta-banner-section sec-section-dark-radius">
  <div class="container">
    <div class="sec-cta-box">
      <div class="sec-cta-content">
        <h2 class="sec-cta-heading">Ready to Elevate Your Security Protection?</h2>
        <p class="sec-cta-desc">
          Get a transparent, customized security quote tailored specifically for your site, assets, and operational needs in minutes.
        </p>
      </div>

      <div class="sec-cta-actions">
        <button class="btn btn-primary btn-cta-quote" id="sec-open-quote-modal-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <line x1="6" y1="8" x2="6.01" y2="8"></line>
            <line x1="10" y1="8" x2="18" y2="8"></line>
            <line x1="6" y1="12" x2="6.01" y2="12"></line>
            <line x1="10" y1="12" x2="18" y2="12"></line>
            <line x1="6" y1="16" x2="6.01" y2="16"></line>
            <line x1="10" y1="16" x2="14" y2="16"></line>
          </svg>
          Calculate Security Quote
        </button>
        <a href="/contact" class="btn btn-outline-white">
          Speak With a Specialist
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <QuoteModal />
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('sec-open-quote-modal-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const modal = document.getElementById('quote-modal');
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      });
    }
  });
</script>

<style>
  .sec-cta-banner-section {
    background-color: var(--sec-navy);
    padding: 5rem 0 6rem 0;
    color: #ffffff;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    margin-top: 1rem;
    position: relative;
    box-shadow: 0 -10px 40px rgba(3, 31, 48, 0.15);
  }

  .sec-cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .sec-cta-content {
    max-width: 650px;
  }

  .sec-cta-badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--sec-purple-light);
    background: rgba(194, 180, 252, 0.15);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .sec-cta-heading {
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .sec-cta-desc {
    font-size: 1.1rem;
    color: #d7d8d6;
    line-height: 1.6;
    margin: 0;
  }

  .sec-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 260px;
  }

  .sec-cta-actions .btn {
    padding: 1.1rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 8px;
    width: 100%;
    justify-content: center;
  }

  .btn-cta-quote {
    background-color: var(--sec-purple);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(108, 71, 207, 0.35);
    border: none;
  }

  .btn-cta-quote:hover {
    background-color: var(--sec-purple-hover);
    color: #ffffff;
    transform: translateY(-2px);
  }

  @media (max-width: 992px) {
    .sec-cta-box {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    .sec-cta-actions {
      width: 100%;
      flex-direction: row;
    }
  }

  @media (max-width: 640px) {
    .sec-cta-actions {
      flex-direction: column;
    }
    .sec-cta-banner-section {
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
      padding: 3.5rem 0 4.5rem 0;
    }
  }
</style>
