---
import { siteInfo } from '../data/siteData';

const rawPhone = siteInfo.phone.replace(/\s+/g, '');
const phoneHref = `tel:${rawPhone}`;
const whatsappHref = `https://wa.me/611300800900?text=Hi%20Security%20Services%2C%20I%20would%20like%20to%20inquire%20about%20your%20services.`;
---

<div class="floating-action-stack" id="floatingStack">
  <!-- Top: Scroll to Top (Black - hidden by default, shown on scroll down) -->
  <button id="scrollToTopBtn" aria-label="Scroll to top" class="floating-btn btn-scroll-top">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </button>

  <!-- Middle: Direct Phone Call (Black) -->
  <a href={phoneHref} aria-label="Call Us" class="floating-btn btn-call">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
  </a>

  <!-- Bottom: WhatsApp Chat (Green) -->
  <a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" class="floating-btn btn-whatsapp">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>
</div>

<style>
  .floating-action-stack {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }

  .floating-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  /* Black Scroll to Top (Hidden by default, shown on scroll down) */
  .btn-scroll-top {
    background-color: #111827;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .btn-scroll-top.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Black Phone Call */
  .btn-call {
    background-color: #111827;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }

  /* Green WhatsApp */
  .btn-whatsapp {
    background-color: #25d366;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
  }
</style>

<script>
  const topBtn = document.getElementById('scrollToTopBtn');

  const toggleTopBtn = () => {
    if (window.scrollY > 200) {
      topBtn?.classList.add('visible');
    } else {
      topBtn?.classList.remove('visible');
    }
  };

  window.addEventListener('scroll', toggleTopBtn, { passive: true });
  toggleTopBtn();

  topBtn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>
