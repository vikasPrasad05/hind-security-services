---
---

<section class="tech-section" id="technology">
  <div class="container">
    <div class="section-header">
      <div class="badge-tag">
        Cutting-Edge Surveillance
      </div>
      <h2 class="section-title">Mobile Solar CCTV Trailers & AI Perimeter Security</h2>
      <p class="section-desc">
        Protect vulnerable construction zones, remote mine perimeters, infrastructure corridors, and outdoor staging areas with zero dependency on fixed power or trenching cables.
      </p>
    </div>

    <div class="tech-grid">
      <div class="tech-image-wrap" style="max-width: 500px; aspect-ratio: 1 / 1;">
        <img src="/images/solar_trailer_500x500.jpg" alt="Mobile Solar CCTV Surveillance Trailer" width="500" height="500" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>

      <div class="tech-content">
        <div class="tech-feature-list" style="margin-top: 0;">
          <div class="tech-feature-card">
            <div class="tech-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            </div>
            <div>
              <h4 style="font-size: 1.05rem; color: var(--navy-dark); margin-bottom: 0.25rem;">100% Solar & High-Capacity Battery Bank</h4>
              <p style="font-size: 0.875rem; color: var(--gray-600);">Continuous 24/7 uptime even through extended cloudy weather cycles with automatic telemetry health alerts.</p>
            </div>
          </div>

          <div class="tech-feature-card">
            <div class="tech-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <div>
              <h4 style="font-size: 1.05rem; color: var(--navy-dark); margin-bottom: 0.25rem;">AI Human & Vehicle Intrusion Detection</h4>
              <p style="font-size: 0.875rem; color: var(--gray-600);">Edge AI filters out wind, rain, and animal motion to eliminate false alarms, triggering instant sub-15s NOC triage.</p>
            </div>
          </div>

          <div class="tech-feature-card">
            <div class="tech-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
            </div>
            <div>
              <h4 style="font-size: 1.05rem; color: var(--navy-dark); margin-bottom: 0.25rem;">Live 2-Way Audio Talk-Down & Strobe Deterrence</h4>
              <p style="font-size: 0.875rem; color: var(--gray-600);">Our central NOC operators can speak directly to trespassers via high-output sirens and warn them before crimes occur.</p>
            </div>
          </div>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
          <a href="/solutions" class="btn btn-primary">Book Trailer Deployment</a>
          <a href="/portal" class="btn btn-outline">Live Demo Feed</a>
        </div>
      </div>
    </div>
  </div>
</section>
