---
import { siteInfo, navigation } from '../data/siteData';
---

<div class="modal-backdrop" id="quoteModal" onclick="if (event.target === this) window.closeQuoteModal();">
  <div class="modal-container">
    <button class="modal-close" onclick="window.closeQuoteModal()" aria-label="Close modal">✕</button>

    <div style="margin-bottom: 1.5rem;">
      <span class="badge-tag">Fast Dispatch</span>
      <h3 style="font-size: 1.5rem; color: var(--navy-dark); margin-top: 0.5rem;">Request a Custom Security Quote</h3>
      <p style="font-size: 0.9rem; color: var(--gray-600);">
        Complete your site requirements and our security management team will contact you within 15 minutes.
      </p>
    </div>

    <form id="quoteModalForm" onsubmit="event.preventDefault(); alert('Proposal request submitted successfully! A Senior Security Director will contact you shortly.'); window.closeQuoteModal(); this.reset();">
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label class="calc-label" for="modalServiceSelect">Primary Security Requirement</label>
          <select id="modalServiceSelect" class="calc-select" required>
            <option value="">-- Choose Security Service --</option>
            {navigation.services.map((s) => (
              <option value={s.slug}>{s.title}</option>
            ))}
            <option value="solar-trailer">Mobile Solar CCTV Surveillance Trailer</option>
            <option value="multi-site">Multi-Site National Security Audit</option>
          </select>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label class="calc-label">Full Name</label>
            <input type="text" class="calc-input" placeholder="e.g. John Doe" required />
          </div>
          <div>
            <label class="calc-label">Company / Organization</label>
            <input type="text" class="calc-input" placeholder="e.g. Acme Corp" required />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label class="calc-label">Business Email</label>
            <input type="email" class="calc-input" placeholder="john@company.com.au" required />
          </div>
          <div>
            <label class="calc-label">Contact Phone</label>
            <input type="tel" class="calc-input" placeholder="0400 000 000" required />
          </div>
        </div>

        <div>
          <label class="calc-label">Site Address / Postcode</label>
          <input type="text" class="calc-input" placeholder="e.g. 100 George St, Sydney NSW 2000" required />
        </div>

        <div>
          <label class="calc-label">Key Requirements / Notes</label>
          <textarea class="calc-input" rows="3" placeholder="Specify site dimensions, shift hours, patrol frequency or specific risk factors..."></textarea>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
          <button type="submit" class="btn btn-primary" style="flex: 1; justify-content: center;">
            Submit Security Tender / Quote Request
          </button>
        </div>

        <p style="font-size: 0.75rem; color: var(--gray-400); text-align: center; margin-top: 0.5rem;">
          🔒 All client operational data is encrypted under AS/NZS ISO 27001 data compliance.
        </p>
      </div>
    </form>
  </div>
</div>
