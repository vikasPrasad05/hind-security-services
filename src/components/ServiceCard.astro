---
interface Props {
  title: string;
  slug: string;
  desc: string;
  image: string;
  icon?: string;
  highlight?: string;
}

const { title, slug, desc, image } = Astro.props;
---

<div class="service-card">
  <div class="service-card-image">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="service-card-body">
    <h3 class="service-card-title">{title}</h3>
    <p class="service-card-desc">{desc}</p>
    <a href="/contact" class="service-card-link">
      LEARN MORE
    </a>
  </div>
</div>
