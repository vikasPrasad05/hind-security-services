---
const insights = [
  {
    title: 'Why PSARA Compliance Matters: A Guide for Indian Businesses Hiring Security',
    category: 'COMPLIANCE GUIDE',
    date: 'SEPTEMBER 2026',
    desc: 'Understanding the Private Security Agencies Regulation Act (PSARA) and why businesses must only hire licensed security agencies for legal protection and quality assurance.',
    image: '/images/slider_3.png',
    link: '/about'
  },
  {
    title: 'How GPS-Tracked Patrols Reduced Industrial Theft by 78% in Silvassa',
    category: 'CASE STUDY',
    date: 'AUGUST 2026',
    desc: 'A detailed case study on how Hind Security\'s GPS-tracked mobile patrol system and 24/7 CCTV monitoring eliminated theft incidents at a major manufacturing facility.',
    image: '/images/slider_team.jpg',
    link: '/services/mobile-patrols'
  },
  {
    title: 'Event Security Best Practices: Lessons from Managing 15,000+ Attendee Festivals',
    category: 'SECURITY INSIGHTS',
    date: 'JULY 2026',
    desc: 'Our event security team shares key learnings from managing large-scale Navratri, Diwali, and corporate events — covering crowd control, entry screening, and emergency planning.',
    image: '/images/indian_security_guards.png',
    link: '/services/major-events'
  }
];
---

<section class="sec-section sec-insights-section">
  <div class="container">
    
    <!-- Section Header -->
    <div class="sec-insights-header">
      <div class="sec-label">
        <span class="sec-purple-line"></span>
        LATEST NEWS & FEATURED STORIES
      </div>
      <h2 class="sec-heading">Security Insights & Industry Updates</h2>
    </div>

    <!-- Insights Grid -->
    <div class="sec-insights-grid">
      {insights.map((item) => (
        <a href={item.link} class="sec-insight-card">
          <div class="sec-insight-image">
            <img src={item.image} alt={item.title} loading="lazy" />
            <span class="sec-insight-tag">{item.category}</span>
          </div>
          <div class="sec-insight-body">
            <span class="sec-insight-date">{item.date}</span>
            <h3 class="sec-insight-title">{item.title}</h3>
            <p class="sec-insight-desc">{item.desc}</p>
            <div class="sec-insight-footer">
              <span class="sec-insight-link">Read story</span>
              <span class="sec-arrow-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .sec-insights-section {
    background-color: var(--sec-grey-bg);
  }

  .sec-insights-header {
    max-width: 800px;
    margin-bottom: 2.5rem;
  }

  .sec-purple-line {
    display: none;
  }

  .sec-insights-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .sec-insight-card {
    background: #ffffff;
    border: 1px solid var(--sec-grey-border);
    border-radius: 0;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.35s ease;
  }

  .sec-insight-card:hover {
    border-color: var(--sec-purple);
    box-shadow: 0 16px 36px rgba(3, 31, 48, 0.1);
  }

  .sec-insight-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: var(--sec-navy);
  }

  .sec-insight-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .sec-insight-tag {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-size: 0.675rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #ffffff;
    background: #000000;
    padding: 0.35rem 0.75rem;
    border-radius: 0;
  }

  .sec-insight-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .sec-insight-date {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sec-purple);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .sec-insight-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--sec-navy);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .sec-insight-desc {
    font-size: 0.9rem;
    color: var(--sec-text-muted);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .sec-insight-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--sec-grey-border);
  }

  .sec-insight-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--sec-navy);
  }

  .sec-insight-card:hover .sec-insight-link {
    color: var(--sec-purple);
  }

  .sec-insight-footer .sec-arrow-circle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--sec-navy);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .sec-insight-card:hover .sec-arrow-circle {
    background-color: var(--sec-purple);
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .sec-insights-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .sec-insights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
