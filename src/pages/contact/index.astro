---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteInfo } from '../../data/siteData';

const branches = [
  { city: "Sydney (NSW Head Office)", address: "Level 14, 201 Kent Street, Sydney NSW 2000", phone: "02 8901 4000", email: "nsw@securityservices.com.au" },
  { city: "Melbourne (VIC Operations)", address: "Level 8, 530 Collins Street, Melbourne VIC 3000", phone: "03 9102 3300", email: "vic@securityservices.com.au" },
  { city: "Brisbane (QLD Operations)", address: "Level 6, 123 Eagle Street, Brisbane QLD 4000", phone: "07 3840 2200", email: "qld@securityservices.com.au" },
  { city: "Perth (WA & National Command HQ)", address: "Level 4, 100 St Georges Terrace, Perth WA 6000", phone: "08 9481 1100", email: "wa@securityservices.com.au" },
  { city: "Adelaide (SA Branch)", address: "Level 3, 50 Flinders Street, Adelaide SA 5000", phone: "08 8210 5500", email: "sa@securityservices.com.au" }
];
---

<BaseLayout
  title="Contact Us & National Operations Centre | Security Services Australia"
  description="Get in touch with our security directors and national control room. Branch offices across Sydney, Melbourne, Brisbane, Perth, and Adelaide."
>
  <div style="background: linear-gradient(135deg, var(--navy-darkest) 0%, var(--navy-dark) 100%); color: #ffffff; padding: 5rem 0 4rem 0;">
    <div class="container">
      <div class="badge-tag dark">Connect With Our Team</div>
      <h1 style="color: #ffffff; margin-bottom: 1rem;">Contact & Branch Locations</h1>
      <p style="color: var(--gray-300); max-width: 750px; font-size: 1.2rem; line-height: 1.6;">
        Our 24/7 National Operations Centre and state branch leadership teams are on standby to address your inquiry or emergency deployment.
      </p>
    </div>
  </div>

  <section style="padding: 6rem 0; background: #ffffff;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem;">
        <!-- Contact Form -->
        <div>
          <span class="badge-tag">Direct Inquiry</span>
          <h2 style="font-size: 2rem; margin-bottom: 1.5rem;">Send Us a Message</h2>

          <form onsubmit="event.preventDefault(); alert('Inquiry received! A Security Services representative will contact you within 15 minutes.'); this.reset();">
            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                  <label class="calc-label">Your Name</label>
                  <input type="text" class="calc-input" placeholder="e.g. John Smith" required />
                </div>
                <div>
                  <label class="calc-label">Company Name</label>
                  <input type="text" class="calc-input" placeholder="e.g. Nexus Logistics" required />
                </div>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                  <label class="calc-label">Email Address</label>
                  <input type="email" class="calc-input" placeholder="john@nexus.com.au" required />
                </div>
                <div>
                  <label class="calc-label">Phone Number</label>
                  <input type="tel" class="calc-input" placeholder="0400 000 000" required />
                </div>
              </div>

              <div>
                <label class="calc-label">State / Region</label>
                <select class="calc-select" required>
                  <option value="">-- Select Your State --</option>
                  <option value="NSW">New South Wales (Sydney & Regional)</option>
                  <option value="VIC">Victoria (Melbourne & Regional)</option>
                  <option value="QLD">Queensland (Brisbane & Regional)</option>
                  <option value="WA">Western Australia (Perth & FIFO)</option>
                  <option value="SA">South Australia (Adelaide)</option>
                  <option value="ACT">Australian Capital Territory</option>
                </select>
              </div>

              <div>
                <label class="calc-label">How Can We Protect Your Facility?</label>
                <textarea class="calc-input" rows="4" placeholder="Describe your site, security concerns, or upcoming event dates..." required></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg" style="justify-content: center;">
                Submit Security Message
              </button>
            </div>
          </form>
        </div>

        <!-- Emergency Contacts & NOC details -->
        <div>
          <div style="background: var(--navy-darkest); color: #ffffff; border-radius: var(--radius-lg); padding: 2.25rem; margin-bottom: 2rem; border: 1px solid rgba(255,255,255,0.1);">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
              <h3 style="color: #ffffff; font-size: 1.3rem;">24/7 National Dispatch</h3>
            </div>
            <p style="color: var(--gray-300); font-size: 0.95rem; margin-bottom: 1.5rem;">
              For live alarm escalations, urgent guard callouts, or immediate patrol dispatches, call our dedicated hotlines:
            </p>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
              <a href={`tel:${siteInfo.phone.replace(/\s+/g, '')}`} class="btn btn-primary" style="justify-content: center;">
                📞 General Enquiries: {siteInfo.phone}
              </a>
              <a href={`tel:${siteInfo.emergencyPhone.replace(/\s+/g, '')}`} class="btn btn-emergency" style="justify-content: center;">
                🚨 Emergency Hotline: {siteInfo.emergencyPhone}
              </a>
            </div>
          </div>

          <div style="background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 1.75rem;">
            <h4 style="font-size: 1.1rem; color: var(--navy-dark); margin-bottom: 0.75rem;">Quality & Master Licences</h4>
            <div style="font-size: 0.85rem; color: var(--gray-600); line-height: 1.6;">
              <p><strong>ABN:</strong> {siteInfo.abn}</p>
              <p><strong>NSW Lic:</strong> 410982391 | <strong>VIC Lic:</strong> 928-102-40S</p>
              <p><strong>QLD Lic:</strong> 48921 | <strong>WA Lic:</strong> SA-59281</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Branch Locations Grid -->
  <section style="padding: 5rem 0; background: var(--gray-50); border-top: 1px solid var(--gray-200);">
    <div class="container">
      <div class="section-header">
        <div class="badge-tag">National Footprint</div>
        <h2 class="section-title">Our Australian Branch Offices</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {branches.map((b) => (
          <div style="background: #ffffff; border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 1.75rem;">
            <h4 style="font-size: 1.15rem; color: var(--navy-dark); margin-bottom: 0.75rem;">{b.city}</h4>
            <p style="font-size: 0.9rem; color: var(--gray-600); margin-bottom: 1rem;">{b.address}</p>
            <div style="font-size: 0.85rem; color: var(--navy-dark); display: flex; flex-direction: column; gap: 0.25rem;">
              <div><strong>Phone:</strong> {b.phone}</div>
              <div><strong>Email:</strong> {b.email}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
