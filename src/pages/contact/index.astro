---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteInfo } from '../../data/siteData';

const branches = [
  { city: "Head Office (Dadra)", address: "Shop No. 02, Pali Corner, Behind Gram Panchayat Dadra, Dadra & Nagar Haveli - 396193", phone: "+91 97237 40019", email: "contact@hindsecurityservices.com" },
  { city: "Dispatch & Field Desk", address: "Shop No. 02, Pali Corner, Behind Gram Panchayat Dadra, Dadra & Nagar Haveli - 396193", phone: "+91 97237 40009", email: "info@hindsecurityservices.com" }
];

const inquiryTypes = [
  "Security Guard Deployment",
  "Armed Security Services",
  "CCTV & Surveillance Installation",
  "Event Security Management",
  "Fire Safety Training",
  "Corporate Security Solutions",
  "Mobile Patrol Services",
  "Security Audit & Consultation",
  "Other / General Inquiry"
];

const faqs = [
  { q: "How quickly can you deploy security guards to my site?", a: "For standard deployments, we can have trained guards on-site within 24-48 hours of contract confirmation. Emergency or urgent requirements can be fulfilled within 6-12 hours depending on location and manpower availability." },
  { q: "What is the minimum contract period for security services?", a: "We offer flexible contract terms starting from monthly agreements. For long-term partnerships, we provide annual contracts with preferential rates, dedicated account management, and priority manpower allocation." },
  { q: "Are your security guards PSARA licensed and police verified?", a: "Absolutely. Every guard deployed by Hind Security Services holds a valid PSARA license and has undergone thorough police verification, criminal background checks, and address verification before assignment." },
  { q: "Do you provide armed security guards?", a: "Yes. We deploy licensed armed security officers for high-risk environments including banks, ATMs, cash-in-transit, jewelry stores, and sensitive government facilities. All armed guards hold valid firearms licenses and undergo advanced tactical training." },
  { q: "What areas do you currently serve?", a: "Our primary operations cover Dadra & Nagar Haveli, Daman & Diu, Gujarat, and Maharashtra. We are expanding across Western India and can discuss deployments in other states based on your requirements." },
  { q: "How do you ensure guard attendance and performance?", a: "We use GPS-tracked patrol systems, biometric/digital attendance, random supervisor inspections, and real-time client dashboards. Monthly performance reports with incident logs are shared with every client." }
];

const emergencyInfo = [
  { label: "24/7 Emergency Hotline", value: "+91 97237 40009", icon: "🚨", desc: "For immediate security emergencies, threats, or urgent guard deployment" },
  { label: "Head Office", value: "+91 97237 40019", icon: "📞", desc: "General inquiries, proposals, and business development" },
  { label: "Email Support", value: "contact@hindsecurityservices.com", icon: "📧", desc: "Written inquiries, documentation, and formal communications" }
];
---

<BaseLayout
  title="Contact Us | Hind Security Services - Get Free Security Consultation"
  description="Contact Hind Security Services for professional security guard deployment, CCTV installation, event security, and consultation. 24/7 emergency hotline available. Office: Shop No. 02, Pali Corner, Dadra & Nagar Haveli."
>
  <div class="page-hero-banner">
    <div class="container">
      <div class="badge-tag dark">Get In Touch</div>
      <h1 style="color: #ffffff; margin-bottom: 1rem;">Contact & Consultation</h1>
      <p class="page-hero-desc">
        Whether you need an immediate security deployment, a free site assessment, or want to discuss a customized security plan — our team is ready to help. Reach out via phone, email, or the inquiry form below.
      </p>
    </div>
  </div>

  <!-- Emergency Contact Strip -->
  <section style="background: var(--navy-darkest); padding: 2.5rem 0;">
    <div class="container">
      <div class="contact-emergency-grid">
        {emergencyInfo.map((item) => (
          <div class="contact-emergency-card">
            <div style="font-size: 1.75rem; margin-bottom: 0.5rem;">{item.icon}</div>
            <div style="font-size: 0.8rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem;">{item.label}</div>
            <div style="font-size: 1.15rem; font-weight: 800; color: #ffffff; margin-bottom: 0.35rem;">{item.value}</div>
            <p style="font-size: 0.8rem; color: #64748b; margin: 0; line-height: 1.4;">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form + Map Section -->
  <section class="page-section">
    <div class="container">
      <div class="contact-split-grid">
        <!-- Contact Form -->
        <div>
          <span class="badge-tag">Security Inquiry Form</span>
          <h2 class="contact-form-title">Tell Us About Your Security Needs</h2>
          <p style="color: var(--gray-500); font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.6;">
            Fill out the form below and our security consultant will contact you within 30 minutes during business hours, or first thing next morning for after-hours inquiries.
          </p>

          <form onsubmit="event.preventDefault(); alert('Inquiry received! A Hind Security Services representative will contact you shortly.'); this.reset();">
            <div class="contact-form-fields">
              <div class="contact-form-row">
                <div>
                  <label class="calc-label">Your Full Name *</label>
                  <input type="text" class="calc-input" placeholder="e.g. Rajesh Kumar" required />
                </div>
                <div>
                  <label class="calc-label">Company / Organization</label>
                  <input type="text" class="calc-input" placeholder="e.g. Tata Motors Ltd." />
                </div>
              </div>

              <div class="contact-form-row">
                <div>
                  <label class="calc-label">Email Address *</label>
                  <input type="email" class="calc-input" placeholder="rajesh@company.com" required />
                </div>
                <div>
                  <label class="calc-label">Phone Number *</label>
                  <input type="tel" class="calc-input" placeholder="+91 98765 43210" required />
                </div>
              </div>

              <div class="contact-form-row">
                <div>
                  <label class="calc-label">State / Region *</label>
                  <select class="calc-select" required>
                    <option value="">-- Select Your State / UT --</option>
                    <option value="DNH">Dadra & Nagar Haveli</option>
                    <option value="DD">Daman & Diu</option>
                    <option value="GJ">Gujarat</option>
                    <option value="MH">Maharashtra</option>
                    <option value="RJ">Rajasthan</option>
                    <option value="MP">Madhya Pradesh</option>
                    <option value="GA">Goa</option>
                    <option value="KA">Karnataka</option>
                    <option value="DL">Delhi NCR</option>
                    <option value="UP">Uttar Pradesh</option>
                    <option value="OTHER">Other State</option>
                  </select>
                </div>
                <div>
                  <label class="calc-label">Service Required *</label>
                  <select class="calc-select" required>
                    <option value="">-- Select Service Type --</option>
                    {inquiryTypes.map((type) => (
                      <option value={type}>{type}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div>
                <label class="calc-label">Site Details & Requirements *</label>
                <textarea class="calc-input" rows="4" placeholder="Describe your site type (factory, office, residential, etc.), number of guards needed, shift requirements, and any specific security concerns..." required></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg" style="justify-content: center; width: 100%;">
                Submit Security Inquiry →
              </button>
              <p style="font-size: 0.8rem; color: var(--gray-400); text-align: center; margin-top: 0.5rem;">
                Your information is kept strictly confidential. We respond within 30 minutes during business hours.
              </p>
            </div>
          </form>
        </div>

        <!-- Google Map + Working Hours -->
        <div>
          <div class="contact-map-box">
            <iframe
              src="https://maps.google.com/maps?q=Shop+No.+02+Pali+Corner+Behind+Gram+Panchayat+Dadra+Dadra+Nagar+Haveli+396193&t=&z=16&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="380"
              style="border: 0; display: block;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Hind Security Services Office Location"
            ></iframe>
          </div>

          <!-- Working Hours Card -->
          <div style="background: var(--gray-50); border: 1px solid var(--gray-200); padding: 1.5rem; margin-top: 1.5rem;">
            <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--navy-dark); margin-bottom: 1rem;">🕐 Office & Operations Hours</h3>
            <div style="display: flex; flex-direction: column; gap: 0.6rem;">
              <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
                <span style="color: var(--gray-600);">Monday – Saturday</span>
                <span style="font-weight: 700; color: var(--navy-dark);">9:00 AM – 7:00 PM</span>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
                <span style="color: var(--gray-600);">Sunday</span>
                <span style="font-weight: 700; color: var(--navy-dark);">10:00 AM – 4:00 PM</span>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9rem; padding-top: 0.6rem; border-top: 1px solid var(--gray-200);">
                <span style="color: var(--gray-600);">Emergency Hotline</span>
                <span style="font-weight: 700; color: #dc2626;">24/7 Available</span>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
                <span style="color: var(--gray-600);">Guard Operations Center</span>
                <span style="font-weight: 700; color: #dc2626;">24/7 Active</span>
              </div>
            </div>
          </div>



        </div>
      </div>
    </div>
  </section>

  <!-- Branch Locations Grid -->
  <section class="page-section" style="background: var(--gray-50);">
    <div class="container">
      <div class="section-header">
        <div class="badge-tag">Office Locations</div>
        <h2 class="section-title">Our Office & Operations Desk</h2>
        <p class="section-desc">Visit our office for face-to-face consultations, or contact our dispatch desk for operational coordination and guard management.</p>
      </div>

      <div class="branch-grid">
        {branches.map((b) => (
          <div class="branch-card">
            <h4 class="branch-city">{b.city}</h4>
            <p class="branch-address">{b.address}</p>
            <div class="branch-contact-info">
              <div><strong>Phone:</strong> {b.phone}</div>
              <div><strong>Email:</strong> {b.email}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <div class="badge-tag">Common Questions</div>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-desc">Quick answers to the most common questions about our security services, deployment process, and compliance standards.</p>
      </div>

      <div class="contact-faq-grid">
        {faqs.map((faq) => (
          <div class="contact-faq-card">
            <h4 class="contact-faq-question">❓ {faq.q}</h4>
            <p class="contact-faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="agency-cta-section">
    <div class="container" style="text-align: center;">
      <h2 style="color: #ffffff; font-size: 2rem; margin-bottom: 1rem;">Need Immediate Security Assistance?</h2>
      <p class="agency-cta-desc">
        Our 24/7 operations center is always ready. Whether you need an emergency guard deployment, a scheduled security consultation, or a detailed proposal — we're just one call away.
      </p>
      <div class="agency-cta-bottom-buttons">
        <button class="btn btn-primary btn-lg" data-quote-trigger>
          Get Free Security Quote
        </button>
        <a href={`tel:${siteInfo.phone.replace(/\s+/g, '')}`} class="btn btn-emergency btn-lg">
          Call {siteInfo.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-emergency-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .contact-emergency-card {
    text-align: center;
    padding: 1rem;
  }
  .contact-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .contact-faq-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    padding: 1.5rem;
    transition: all 0.3s ease;
  }
  .contact-faq-card:hover {
    border-color: #3b82f6;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .contact-faq-question {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy-dark);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .contact-faq-answer {
    font-size: 0.9rem;
    color: var(--gray-600);
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 768px) {
    .contact-emergency-grid {
      grid-template-columns: 1fr;
    }
    .contact-faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
