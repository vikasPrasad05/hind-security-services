---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Client Live Operations Portal | Security Services Australia"
  description="Real-time client dashboard: Live GPS mobile patrol tracking, CCTV camera views, incident response logs, and compliance audit downloads."
>
  <div style="background: linear-gradient(135deg, var(--navy-darkest) 0%, var(--navy-dark) 100%); color: #ffffff; padding: 3rem 0 2rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>

        <h1 style="color: #ffffff; font-size: 2rem;">Client Command & Operations Portal</h1>
        <p style="color: var(--gray-300); font-size: 0.95rem;">Facility ID: <strong>SYD-CBD-TOWER-88</strong> (Live Telemetry & Patrol Feed)</p>
      </div>

      <div style="display: flex; gap: 0.75rem;">
        <button class="btn btn-outline-white btn-sm" onclick="alert('Exporting complete audit PDF log for current billing cycle...');">
          📥 Export Audit Report
        </button>
        <button class="btn btn-emergency btn-sm" onclick="alert('Priority Duress Signal Sent to 24/7 National Operations Centre! Operator will call site in 10 seconds.');">
          🚨 Request Priority Dispatch
        </button>
      </div>
    </div>
  </div>

  <section style="padding: 2.5rem 0 5rem 0; background: #0c152c; color: #ffffff; min-height: 80vh;">
    <div class="container">
      <!-- Portal Top Stats Bar -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div style="background: #152244; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.08);">
          <div style="color: var(--gray-400); font-size: 0.8rem; text-transform: uppercase;">Assigned Patrol Unit</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #ffffff; margin-top: 0.25rem;">Patrol 42 (Delta)</div>
          <div style="color: #4ade80; font-size: 0.75rem; margin-top: 0.25rem;">● En Route - ETA 6 mins</div>
        </div>

        <div style="background: #152244; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.08);">
          <div style="color: var(--gray-400); font-size: 0.8rem; text-transform: uppercase;">Active Site Guards</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #ffffff; margin-top: 0.25rem;">4 Officers On Duty</div>
          <div style="color: #60a5fa; font-size: 0.75rem; margin-top: 0.25rem;">All checkpoints verified</div>
        </div>

        <div style="background: #152244; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.08);">
          <div style="color: var(--gray-400); font-size: 0.8rem; text-transform: uppercase;">Solar CCTV Unit</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #ffffff; margin-top: 0.25rem;">Trailer-09 (North)</div>
          <div style="color: #4ade80; font-size: 0.75rem; margin-top: 0.25rem;">Battery 98% • AI Tripwire Armed</div>
        </div>

        <div style="background: #152244; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.08);">
          <div style="color: var(--gray-400); font-size: 0.8rem; text-transform: uppercase;">Perimeter Threat Level</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #4ade80; margin-top: 0.25rem;">SECURE (LOW)</div>
          <div style="color: var(--gray-400); font-size: 0.75rem; margin-top: 0.25rem;">Last sweep: 22 mins ago</div>
        </div>
      </div>

      <!-- Main Portal Grid -->
      <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem;">
        <!-- Left Column: Camera Feeds & Map -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div style="background: #152244; border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.1); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h3 style="color: #ffffff; font-size: 1.15rem;">Live Surveillance Feeds (Encrypted Stream)</h3>
              <span style="color: #eab308; font-size: 0.75rem; font-weight: 700; background: rgba(234, 179, 8, 0.2); padding: 0.2rem 0.5rem; border-radius: 4px;">● LIVE REC</span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <!-- Camera 1 -->
              <div style="position: relative; border-radius: var(--radius-sm); overflow: hidden; background: #000;">
                <img src="/images/service_male_patrol.jpg" style="width: 100%; height: 180px; object-fit: cover; opacity: 0.85;" />
                <div style="position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,0.7); font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 2px;">
                  CAM 01: Front Gate & Barrier
                </div>
                <div style="position: absolute; bottom: 8px; right: 8px; color: #4ade80; font-size: 0.7rem; font-family: monospace;">
                  AI: Person Detected (Guard ID 884)
                </div>
              </div>

              <!-- Camera 2 -->
              <div style="position: relative; border-radius: var(--radius-sm); overflow: hidden; background: #000;">
                <img src="/images/solar_trailer.jpg" style="width: 100%; height: 180px; object-fit: cover; opacity: 0.85;" />
                <div style="position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,0.7); font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 2px;">
                  CAM 02: Solar Trailer Mast PTZ
                </div>
                <div style="position: absolute; bottom: 8px; right: 8px; color: #4ade80; font-size: 0.7rem; font-family: monospace;">
                  360° AI Tripwire Active
                </div>
              </div>
            </div>
          </div>

          <!-- GPS Patrol Tracking Simulation -->
          <div style="background: #152244; border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.1); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h3 style="color: #ffffff; font-size: 1.15rem;">Live GPS Patrol Vehicle & Checkpoint Map</h3>
              <span style="font-size: 0.8rem; color: #93c5fd;">GPS Accuracy: ± 1.5m</span>
            </div>
            
            <div style="background: #091124; border-radius: var(--radius-sm); height: 220px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; border: 1px dashed rgba(255,255,255,0.2);">
              <div style="position: absolute; width: 100%; height: 100%; background: radial-gradient(circle, rgba(37,99,235,0.15) 10%, transparent 70%);"></div>
              <div style="text-align: center; z-index: 2;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🛰️</div>
                <div style="font-weight: 700; color: #ffffff;">Patrol Unit 42 Moving on Perimeter Road 4</div>
                <div style="font-size: 0.8rem; color: #9ca3af; margin-top: 0.25rem;">Speed: 24 km/h • Last Tag: North Gate NFC Scan (Success)</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Real-time Incident & Dispatch Log -->
        <div style="background: #152244; border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.1); padding: 1.5rem; display: flex; flex-direction: column;">
          <h3 style="color: #ffffff; font-size: 1.15rem; margin-bottom: 1rem; display: flex; align-items: center; justify-content: space-between;">
            <span>Real-Time NOC Event Log</span>
            <span style="font-size: 0.75rem; color: #4ade80;">Auto-sync (2s)</span>
          </h3>

          <div style="display: flex; flex-direction: column; gap: 0.85rem; overflow-y: auto; max-height: 480px; padding-right: 0.5rem;">
            <div style="background: rgba(255,255,255,0.04); padding: 0.85rem; border-radius: var(--radius-sm); border-left: 3px solid #22c55e;">
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #9ca3af;">
                <span>04:12:08 AM</span>
                <span style="color: #4ade80;">VERIFIED</span>
              </div>
              <div style="font-weight: 700; font-size: 0.85rem; color: #ffffff; margin: 0.2rem 0;">Patrol Sweep 03 Completed</div>
              <div style="font-size: 0.75rem; color: #cbd5e1;">Officer tagged all 14 RFID checkpoints. Main gates locked & secure.</div>
            </div>

            <div style="background: rgba(255,255,255,0.04); padding: 0.85rem; border-radius: var(--radius-sm); border-left: 3px solid #3b82f6;">
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #9ca3af;">
                <span>02:45:19 AM</span>
                <span style="color: #60a5fa;">INFO</span>
              </div>
              <div style="font-weight: 700; font-size: 0.85rem; color: #ffffff; margin: 0.2rem 0;">Loading Dock Access Granted</div>
              <div style="font-size: 0.75rem; color: #cbd5e1;">Linfox Delivery vehicle #882 scanned by Concierge Guard ID: 412.</div>
            </div>

            <div style="background: rgba(255,255,255,0.04); padding: 0.85rem; border-radius: var(--radius-sm); border-left: 3px solid #f59e0b;">
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #9ca3af;">
                <span>01:10:44 AM</span>
                <span style="color: #fbbf24;">TRIAGED</span>
              </div>
              <div style="font-weight: 700; font-size: 0.85rem; color: #ffffff; margin: 0.2rem 0;">Solar Trailer Motion Alert</div>
              <div style="font-size: 0.75rem; color: #cbd5e1;">Sub-12s NOC review verified wildlife motion outside fence line. No breach.</div>
            </div>

            <div style="background: rgba(255,255,255,0.04); padding: 0.85rem; border-radius: var(--radius-sm); border-left: 3px solid #22c55e;">
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #9ca3af;">
                <span>23:00:00 PM</span>
                <span style="color: #4ade80;">ARMED</span>
              </div>
              <div style="font-weight: 700; font-size: 0.85rem; color: #ffffff; margin: 0.2rem 0;">Perimeter & Building Arming</div>
              <div style="font-size: 0.75rem; color: #cbd5e1;">All 44 access control zones armed. Grade A1 monitoring active.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
