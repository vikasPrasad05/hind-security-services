---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { navigation, siteInfo } from '../../data/siteData';

const sectorDetails = [
  {
    title: "Commercial Real Estate & Premier High-Rise Towers",
    desc: "Seamless tenant concierge, automated speedgate turnstiles, loading dock traffic control, after-hours patrols, and emergency evacuation management.",
    risks: ["Unauthorized floor access", "Loading dock congestion & tailgating", "Tenant after-hours safety", "Building asset vandalism"],
    solutions: ["Concierge customer security", "Destination dispatch lift integration", "RAPID patrol guard tours", "24/7 CCTV NOC surveillance"]
  },
  {
    title: "Aviation & Critical Transport Hubs",
    desc: "Strict compliance with Aviation Transport Security Regulations. ASIC-cleared officers, passenger screening, baggage x-ray, airside perimeter patrols.",
    risks: ["Sterile zone breaches", "Luggage tampering & smuggling", "Unruly passenger de-escalation", "Perimeter fence intrusion"],
    solutions: ["ASIC licensed screening personnel", "Thermal perimeter radar detection", "Mobile airside response fleet", "K9 explosives detection"]
  },
  {
    title: "Healthcare, Hospitals & Aged Care Facilities",
    desc: "Empathetic, de-escalation focused security protecting nursing staff, emergency departments, and vulnerable patients 24/7.",
    risks: ["Emergency department occupational violence", "Drug & pharmacy inventory theft", "Vulnerable patient wander prevention", "Duress alarm delays"],
    solutions: ["Code Black de-escalation officers", "Instant wireless duress pendants", "Biometric pharmacy access control", "Fixed 24/7 ER guard posts"]
  },
  {
    title: "Retail, Logistics & Multi-Distribution Warehouses",
    desc: "Integrated loss prevention, inventory audit verification, gatehouse weighbridge inspection, and autonomous solar CCTV trailer perimeters.",
    risks: ["Internal & external shrinkage", "Organized retail crime (ORC)", "Distribution centre yard theft", "Unmanifested truck dispatch"],
    solutions: ["Uniformed & covert loss prevention", "Solar CCTV towers with AI tripwire", "Automated gatehouse barcode scanners", "Trailer seal verification"]
  },
  {
    title: "Government, Defence & Critical Infrastructure",
    desc: "High-security cleared personnel, AS/NZS ISO 27001 data compliance, biometric perimeter fencing, and continuous threat monitoring.",
    risks: ["State-sponsored espionage", "Physical infrastructure sabotage", "Unauthorized photography/drones", "Compliance audit failure"],
    solutions: ["NV1 & Baseline cleared officers", "Anti-drone RF detection systems", "Dual-factor biometric access control", "Encrypted Grade A1 NOC logging"]
  },
  {
    title: "Mining, Energy & Remote Resource Projects",
    desc: "Dual medical-security fly-in fly-out teams, alcohol & drug screening checkpoints, remote camp peace preservation, and emergency bushfire response.",
    risks: ["Remote medical emergencies", "Camp disputes & substance abuse", "Equipment & copper theft", "Extreme weather isolation"],
    solutions: ["Paramedic-security hybrid teams", "Breathalyzer & gatehouse control", "4WD off-road patrol vehicles", "Satellite backhaul CCTV monitoring"]
  }
];
---

<BaseLayout
  title="Industry Sectors We Protect | Security Services Australia"
  description="Custom security frameworks engineered for Commercial Real Estate, Aviation, Healthcare, Retail, Government, and Mining Resources."
>
  <div style="background: linear-gradient(135deg, var(--navy-darkest) 0%, var(--navy-dark) 100%); color: #ffffff; padding: 4.5rem 0 3.5rem 0;">
    <div class="container">
      <div class="badge-tag dark">Sector-Specific Protocols</div>
      <h1 style="color: #ffffff; margin-bottom: 1rem;">Industry Sectors We Protect</h1>
      <p style="color: var(--gray-300); max-width: 750px; font-size: 1.15rem;">
        Every industry operates within distinct regulatory mandates and risk environments. We engineer custom security frameworks tailored to your operational reality.
      </p>
    </div>
  </div>

  <section style="padding: 6rem 0; background: #ffffff;">
    <div class="container">
      <div style="display: flex; flex-direction: column; gap: 3.5rem;">
        {sectorDetails.map((sec, idx) => (
          <div style="background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-lg); padding: 2.5rem; display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.5rem; align-items: center;">
            <div>
              <span class="badge-tag" style="margin-bottom: 0.5rem;">Sector 0{idx + 1}</span>
              <h2 style="font-size: 1.6rem; color: var(--navy-dark); margin-bottom: 1rem;">{sec.title}</h2>
              <p style="color: var(--gray-700); font-size: 1rem; line-height: 1.6; margin-bottom: 1.5rem;">{sec.desc}</p>
              
              <button class="btn btn-primary btn-sm" data-quote-trigger>
                Request Sector SLA Assessment
              </button>
            </div>

            <div style="background: #ffffff; border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 1.75rem;">
              <h4 style="font-size: 0.95rem; text-transform: uppercase; color: var(--primary-red); margin-bottom: 0.75rem; letter-spacing: 0.05em;">Typical Risk Vectors</h4>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem; color: var(--gray-700); margin-bottom: 1.25rem;">
                {sec.risks.map((r) => (
                  <li style="display: flex; align-items: center; gap: 0.4rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>

              <h4 style="font-size: 0.95rem; text-transform: uppercase; color: var(--navy-dark); margin-bottom: 0.75rem; letter-spacing: 0.05em;">Our Deployed Architecture</h4>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem; color: var(--gray-700);">
                {sec.solutions.map((s) => (
                  <li style="display: flex; align-items: center; gap: 0.4rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <strong style="color: var(--navy-dark);">{s}</strong>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
